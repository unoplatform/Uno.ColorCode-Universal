<Project Sdk="Uno.Sdk.Private">

	<PropertyGroup>
		<TargetFrameworks>net10.0-desktop</TargetFrameworks>
		<TargetFrameworks Condition=" '$(OS)' == 'Windows_NT' ">$(TargetFrameworks);net10.0-windows10.0.19041</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>
		<RootNamespace>ColorCode.WinUITests</RootNamespace>
		<WindowsPackageType>None</WindowsPackageType>
		<IsPackable>false</IsPackable>

		<ApplicationTitle>ColorCode.WinUITests</ApplicationTitle>
		<ApplicationId>uno.platform.colorcode.winuitests</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationPublisher>Uno Platform</ApplicationPublisher>

		<UnoFeatures>
			SkiaRenderer;
		</UnoFeatures>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\ColorCode.Core\ColorCode.Core.csproj" />
		<ProjectReference Include="..\..\ColorCode.HTML\ColorCode.HTML.csproj" />
		<ProjectReference Include="..\..\ColorCode.WinUI\ColorCode.WinUI.csproj" />
	</ItemGroup>

</Project>
