<Page x:Class="ColorCode.WinUITests.MainPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid x:Name="MainGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*" />
			<ColumnDefinition Width="2*" />
		</Grid.ColumnDefinitions>

		<StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Padding="8">
			<ComboBox x:Name="LanguagePicker" Width="180" SelectionChanged="OnSelectionChanged" />
			<ToggleSwitch x:Name="DarkToggle" OnContent="Dark" OffContent="Light" Toggled="OnSelectionChanged" />
		</StackPanel>

		<ScrollViewer Grid.Row="1"
					  HorizontalScrollBarVisibility="Auto"
					  HorizontalScrollMode="Auto">
			<RichTextBlock x:Name="PresentationBlock"
						   Padding="12"
						   FontFamily="Consolas"
						   FontSize="14" />
		</ScrollViewer>

		<TextBox x:Name="InlineTree"
				 Grid.Row="1"
				 Grid.Column="1"
				 IsReadOnly="True"
				 AcceptsReturn="True"
				 TextWrapping="NoWrap"
				 FontFamily="Consolas"
				 FontSize="11"
				 ScrollViewer.HorizontalScrollBarVisibility="Auto"
				 ScrollViewer.VerticalScrollBarVisibility="Auto" />
	</Grid>
</Page>
