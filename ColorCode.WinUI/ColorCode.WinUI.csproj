<Project Sdk="Uno.Sdk">

	<PropertyGroup>
		<!-- Uno 7.0 renders every non-Windows target through the net10.0 (Skia) assembly. -->
		<TargetFrameworks>net10.0</TargetFrameworks>
		<TargetFrameworks Condition=" '$(OS)' == 'Windows_NT' ">$(TargetFrameworks);net10.0-windows10.0.19041</TargetFrameworks>
		<!-- Uno.Sdk otherwise derives it from GeneratePackageOnBuild, and adds app-only logging packages when false. -->
		<IsPackable>true</IsPackable>
		<RootNamespace>ColorCode</RootNamespace>
		<AssemblyName>ColorCode.WinUI</AssemblyName>
		<PackageId>Uno.ColorCode.WinUI</PackageId>
		<Title>ColorCode.WinUI</Title>
		<Description>Contains the RichTextBlockFormatter, for rendering the Colorized Code to a RichTextBlock.</Description>
		<PackageTags>ColorCode Syntax Highlighting SyntaxHighlighting Formatting WinUI RichTextBlock Document InlineCollection</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ColorCode.Core\ColorCode.Core.csproj" />
	</ItemGroup>

	<!--
		Uno.Sdk implies the 'skia' feature and injects the renderer add-ins it brings. The renderer is the app's
		choice and this library uses none of them, so drop them. Marking them private is not enough: the XAML
		generator would still chain the generated GlobalStaticResources into every add-in it is compiled against,
		and an app without that add-in would fail to load it.
	-->
	<Target Name="_ColorCodeRemoveRendererPackages" AfterTargets="UnoImplicitPackages">
		<ItemGroup>
			<PackageReference Remove="Uno.WinUI.Composition.Skia;Uno.WinUI.Graphics2DSK" />
		</ItemGroup>
	</Target>

</Project>
